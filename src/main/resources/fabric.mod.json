{
  "schemaVersion": 1,
  "id": "seamless_loading_screen",
  "version": "${version}",
  "name": "Seamless Loading Screen Continued",
  "description": "Takes a screenshot of the game when you leave a world or server, and displays it when you rejoin it. Unofficial continuation for Minecraft 26.2+.",
  "authors": [
    "Henner4746 (Port Maintainer)",
    "Minenash (Original Author)"
  ],
  "contributors": [
    "Blodhgarm"
  ],
  "contact": {
    "homepage": "https://github.com/Henner4746/Seamless-Loading-Screen",
    "issues": "https://github.com/Henner4746/Seamless-Loading-Screen/issues",
    "sources": "https://github.com/Henner4746/Seamless-Loading-Screen"
  },
  "license": "MIT",
  "icon": "assets/seamless_loading_screen/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.minenash.seamless_loading_screen.SeamlessLoadingScreenFabric"
    ],
    "modmenu": [
      "com.minenash.seamless_loading_screen.config.ModMenuEntryPoint"
    ]
  },
  "mixins": [
    "seamless_loading_screen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=25",
    "yet_another_config_lib_v3": "*"
  },
  "recommends": {
    "modmenu": "*"
  },
  "conflicts": {
    "wynntils": "*"
  }
}
